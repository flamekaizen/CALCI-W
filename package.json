{
  "name": "calci-web",
  "private": true,
  "version": "1.1.0",
  "description": "Calci: an all-in-one advanced calculator. Scientific, graphing, 3D, programmer, matrix, solver, calculus, statistics, finance, units and scripting.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build && vite build --config vite.sdk.config.ts && vite build --config vite.embed.config.ts",
    "build:native": "vite build --mode native",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "mathjs": "^15.2.0",
    "mathlive": "^0.111.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vercel/node": "^30.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  }
}
